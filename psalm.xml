<?xml version="1.0"?>
<!--
    errorLevel="8" is Psalm's loosest, most-permissive level (1
    is Psalm's strictest) — the opposite direction from PHPStan's own
    `level: 8` in phpstan.neon, which IS PHPStan's strictest level. The two
    `8`s are not comparable strictness settings despite the shared number.
-->
<psalm
    errorLevel="8"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <!--
        The driver extensions are `suggest`ed, not required, so Psalm
        only auto-loads their stubs when the analyzing PHP has them
        loaded. Reference them explicitly instead: analysis must give
        the same answer in a bare CLI container as on a fully-equipped
        host.
    -->
    <stubs>
        <file name="vendor/vimeo/psalm/stubs/extensions/mysqli.phpstub" />
        <file name="stubs/driver-extensions.phpstub" />
        <file name="stubs/pdo-mysql.phpstub" />
    </stubs>
</psalm>
